# ---------------------------------------------------------------------------
# Copy to .env.local for development. In production these are set in the
# Vercel dashboard under Settings > Environment Variables.
#
# .env.local is gitignored. Never commit real keys — a key in git history is
# compromised even after you delete it, and it has to be rotated.
# ---------------------------------------------------------------------------

# --- Voice input ------------------------------------------------------------
# A Gemini API key from https://aistudio.google.com/apikey
#
# Without this the app still works: every question can be typed, validation
# runs and the summary prints. Only the microphone button is switched off,
# and it says so rather than failing silently.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
#
# It must be a general multimodal model, not a transcribe-only one: a single
# call has to return the transcript, the detected language AND an English
# translation as JSON against a schema. If you ever drop the translation
# requirement, gemini-3.5-transcribe would be cheaper and faster.
GEMINI_MODEL=

# --- Rate limiting ----------------------------------------------------------
# From the Upstash console, or auto-injected if you add Upstash through the
# Vercel Marketplace.
#
# WITHOUT THESE the app falls back to an in-memory counter. That is fine for
# local development, but on Vercel it does NOT enforce the limit: each
# serverless instance keeps its own count, so the real ceiling becomes
# 60 x (however many instances are running). Check /api/status after
# deploying — if it reports "degraded": true, these are not set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any random string. Used to hash IP addresses before they are used as rate
# limit keys, so a raw IP never reaches Redis or the logs.
# Generate one with:  openssl rand -hex 32
RATE_LIMIT_SALT=
